# Copy this file to .env and fill both values from Supabase -> Project Settings -> API Keys (see README 2.5).
# The key is the Publishable key (sb_publishable_...) or the legacy "anon public" key. Never the secret/service_role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
